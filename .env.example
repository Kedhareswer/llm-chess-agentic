DATABASE_URL=postgresql://...

# AI providers — OPTIONAL. Keys are bring-your-own: each user enters their own
# key in Settings (kept in their browser) and it is used only for the matches
# they start. Set a key here only for local dev / self-hosting if you want every
# game to fall back to one key without typing it. There is no server-managed
# global key and no admin token.
# GROQ_API_KEY=your-groq-api-key
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# AI_GATEWAY_API_KEY=your-ai-gateway-api-key
